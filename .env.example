# Copy to .env.local for local testing, or set in Spaceship/Hyperlift's
# environment variable settings for a deployed build.

# Lets you confirm the host's build step actually injects env vars.
VITE_BUILD_MARKER=set-me-to-anything

# Points the contact form at a mail-relay endpoint. For the Spaceship test,
# use the deployed path to api/contact.php, e.g.:
# VITE_CONTACT_ENDPOINT=https://your-test-domain.example/api/contact.php
VITE_CONTACT_ENDPOINT=
